# Database Configuration
# DB_TYPE: "mysql" (default) or "postgres"
DB_TYPE=mysql
# DB_DSN: Direct connection string (optional, used for postgres)
# Example: postgresql://user:password@host:port/dbname?sslmode=require
DB_DSN=
DB_HOST=xxxxxxxx
DB_USER=xxxxxxxx
DB_PASSWORD=xxxxxxxx
DB_NAME=xxxxxxxx
# MySQL default: 3306, PostgreSQL default: 5432
DB_PORT=3307

# Server Configuration
SERVER_PORT=8090

# bitFlyer API Configuration
BITFLYER_API_URL=https://api.bitflyer.com
BITFLYER_API_KEY=your_api_key_here
BITFLYER_API_SECRET=your_api_secret_here

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000
