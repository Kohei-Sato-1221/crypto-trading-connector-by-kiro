# Database Configuration
# どちらか一方、または両方を設定してください。両方設定した場合はPostgreSQLが優先されます。
# 両方空の場合はアプリケーションが起動時にpanicします。
MYSQL_URL=user:password@tcp(host:port)/dbname?parseTime=true&loc=Local
POSTGRES_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Server Configuration
SERVER_PORT=8090

# bitFlyer API Configuration
BITFLYER_API_URL=https://api.bitflyer.com
BITFLYER_API_KEY=your_api_key_here
BITFLYER_API_SECRET=your_api_secret_here

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000
